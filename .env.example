# ==============================================================
# Kartik Joshi Portfolio - Environment Variables
# ==============================================================

# 1. MongoDB Atlas Connection URI
# Replace <db_password> with your actual MongoDB Atlas database user password.
# Database name can be 'portfolio' or any preferred name.
MONGODB_URI=mongodb+srv://kartikjoshi842_db_user:<db_password>@cluster0.pwvqkig.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio

# 2. Email Notification Service (Contact Form)
# Option A (Recommended for Netlify - Zero Setup):
# Get a free access key from https://web3forms.com (takes 10 seconds, delivers to kartikjoshi842@gmail.com)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_key_here

# Option B (Resend API Key):
# RESEND_API_KEY=re_your_resend_api_key

# 3. Target Email
CONTACT_RECEIVER_EMAIL=kartikjoshi842@gmail.com

# 4. Port for local server (optional)
PORT=3001
